---
import type { CollectionEntry } from "astro:content";
import { Font } from "astro:assets";
import ThemeToggle from "../components/theme/ThemeToggle.astro";
import Search from "../components/search/Search.astro";
import { ClientRouter } from "astro:transitions";
import { localeInfo, home, type Locale } from "../i18n/locales";
import { messages } from "../i18n/messages";
import { site } from "../site";
import {
  ArrowUp,
  Languages,
  NotebookPen,
  Rss,
  StickyNote,
  UserRound,
} from "@lucide/astro";
import Mark from "../components/Mark.astro";
import GitHub from "../assets/github.svg";
// Establish cascade order before conditional math styles.
import styles from "../styles/global.css?url";
import MathStyles from "../components/MathStyles.astro";
interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  alternates?: readonly { readonly locale: Locale; readonly url: string }[];
  languageUrl?: string | undefined;
  missingTranslation?: boolean;
  noindex?: boolean;
  article?: CollectionEntry<"posts">["data"];
}
const {
  locale = "en",
  title = `${site.author} — ${messages[locale].volume}`,
  description = messages[locale].description,
  alternates = [],
  languageUrl,
  missingTranslation = false,
  noindex = false,
  article,
} = Astro.props;
// Inspect the rendered slot for MathML before emitting the head; reuse it in the body.
const content = await Astro.slots.render("default");
const hasMath = content.includes("<math");
const t = messages[locale];
const other = localeInfo[locale].other;
const canonical = new URL(Astro.url.pathname, site.url);
const socialImage = new URL(
  `/og/${locale}${article ? `/posts/${article.slug}` : ""}.png`,
  site.url,
);
const structuredData = article && {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  description,
  url: canonical.href,
  mainEntityOfPage: canonical.href,
  image: socialImage.href,
  inLanguage: localeInfo[locale].tag,
  datePublished: article.publishedAt.toISOString(),
  dateModified: (article.updatedAt ?? article.publishedAt).toISOString(),
  author: { "@type": "Person", name: site.author, url: site.github },
};
const root = Astro.url.pathname === "/";
const navigation = (
  [
    ["writing", NotebookPen],
    ["notes", StickyNote],
    ["about", UserRound],
  ] as const
).map(([item, icon]) => ({
  label: t[item],
  href: item === "writing" ? home(locale) : `${home(locale)}${item}/`,
  icon,
}));
const leave = {
  name: "page-leave",
  duration: "160ms",
  easing: "ease-in",
  fillMode: "both",
};
const enter = {
  name: "page-enter",
  duration: "400ms",
  delay: "80ms",
  easing: "cubic-bezier(0.2, 0, 0, 1)",
  fillMode: "both",
};
const pageTransition = {
  forwards: { old: leave, new: enter },
  backwards: { old: leave, new: { ...enter, name: "page-return" } },
};
---

<!doctype html>
<html
  lang={localeInfo[locale].tag}
  transition:name="root"
  transition:animate={pageTransition}
>
  <head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href={styles} />
    <Font cssVariable="--font-prose" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-mono" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={localeInfo[alternate.locale].tag}
        href={new URL(alternate.url, site.url)}
      />
    ))}
    {(root || Astro.url.pathname === home(locale)) && (
      <link rel="alternate" hreflang="x-default" href={site.url + "/"} />
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.author} — ${localeInfo[locale].label}`}
      href={`/${locale}/rss.xml`}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {hasMath && <MathStyles />}
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.author} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={article?.title ?? site.author} />
    <meta name="twitter:card" content="summary_large_image" />
    {article && (
      <meta
        property="article:published_time"
        content={article.publishedAt.toISOString()}
      />
    )}
    {article?.updatedAt && (
      <meta
        property="article:modified_time"
        content={article.updatedAt.toISOString()}
      />
    )}
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
      ></script>
    )}
    <script is:inline>
      (() => {
        let choice = "system";
        try {
          choice = localStorage.getItem("theme") || "system";
        } catch {
          // Storage is optional; the system theme remains available.
        }
        document.documentElement.dataset.theme =
          choice === "light" || choice === "dark"
            ? choice
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
      })();
    </script>
    <ClientRouter fallback="none" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <div class="site-shell">
      <header
        class="author-rail"
        aria-label={site.author}
        transition:name="author"
        transition:animate="none"
      >
        <a
          class="identity"
          href={root ? "/" : home(locale)}
          aria-label={`${site.author} — ${t.home}`}
        >
          <Mark />
          <span class="identity-name">{site.author}</span>
        </a>
        <p class="motto" lang="en">
          Keep it simple,
          <br />
          stupid.
        </p>
        <nav aria-label={t.navigation} class="main-nav">
          {navigation.map(({ label, href, icon: Icon }) => (
            <a
              class="nav-link"
              href={href}
              aria-current={Astro.url.pathname === href ? "page" : undefined}
            >
              <Icon class="nav-icon" aria-hidden="true" />
              {label}
            </a>
          ))}
        </nav>
        <div class="rail-bottom">
          <a
            lang={localeInfo[other].tag}
            hreflang={localeInfo[other].tag}
            class="language-link"
            href={languageUrl ?? home(other)}
            aria-label={
              missingTranslation ? t.otherArchive : localeInfo[other].label
            }
          >
            <Languages aria-hidden="true" />
            {localeInfo[other].label}
          </a>
          <div class="rail-tools">
            <ThemeToggle locale={locale} />
            <a href={site.github} aria-label="GitHub">
              <GitHub width="20" height="20" aria-hidden="true" />
            </a>
            <a href={`/${locale}/rss.xml`} aria-label={t.feed}>
              <Rss />
            </a>
          </div>
        </div>
      </header>
      <div class="page-column">
        <div class="page-top">
          <a href={root ? "/" : home(locale)}>{t.volume}</a>
          <Search locale={locale} />
        </div>
        <main
          id="main"
          tabindex="-1"
          data-reading
          data-references={content.includes("tml-ref")}
        >
          <Fragment set:html={content} />
        </main>
        <footer class="site-footer">
          <span>
            © {new Date().getUTCFullYear()} {site.author}
          </span>
          <span>{t.footer}</span>
          <a href="#main" aria-label={t.top}>
            <ArrowUp />
          </a>
        </footer>
      </div>
    </div>
    <script src="../client/lifecycle.ts"></script>
  </body>
</html>
