---
import "../styles/article.css";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import Page from "./Page.astro";
import PostList from "../components/PostList.astro";
import License from "../components/License.astro";
import { ArrowLeft, ArrowRight } from "@lucide/astro";
import { localeInfo, dateLabel } from "../i18n/locales";
import { tagLabel, topicUrl } from "../i18n/tags";
import { messages } from "../i18n/messages";
import { getPosts } from "../lib/collections";
import {
  counterpart,
  postUrl,
  readingMinutes,
  relatedPosts,
} from "../lib/publications";
import { site } from "../lib/site";
interface Props {
  post: CollectionEntry<"posts">;
  headings: readonly MarkdownHeading[];
}
const { post, headings } = Astro.props;
const locale = post.data.locale;
const t = messages[locale];
const posts = await getPosts();
const translation = counterpart(post, posts, localeInfo[locale].other);
const sections = headings.filter(
  ({ depth, slug }) => depth === 2 && slug !== "footnote-label",
);
const related = relatedPosts(post, posts);
const alternates = [post, translation]
  .filter((entry) => entry !== undefined)
  .map((entry) => ({ locale: entry.data.locale, url: postUrl(entry) }));
---

<Page
  locale={locale}
  title={`${post.data.title} — ${site.author}`}
  description={post.data.description}
  alternates={alternates}
  languageUrl={translation ? postUrl(translation) : undefined}
  missingTranslation={!translation}
  article={post.data}
>
  <article data-pagefind-body>
    <a class="back-link" href={`/${locale}/`} data-pagefind-ignore>
      <ArrowLeft />
      {t.back}
    </a>
    <header class="article-heading">
      <div class="eyebrow" data-pagefind-ignore>
        <span class="topic-links">
          {post.data.tags.map((tag) => (
            <a href={topicUrl(tag, locale)}>{tagLabel(tag, locale)}</a>
          ))}
          {post.data.sample && <span>{t.sample}</span>}
        </span>
        <span>{t.readingTime(readingMinutes(post.body ?? ""))}</span>
      </div>
      <h1>
        <span class="post-title" data-title-key={post.id}>
          {post.data.title}
        </span>
      </h1>
      <p class="lead">{post.data.description}</p>
      <div class="article-meta" data-pagefind-ignore>
        <span>{site.author}</span>
        <span aria-hidden="true">/</span>
        <time datetime={post.data.publishedAt.toISOString()}>
          {dateLabel(post.data.publishedAt, locale)}
        </time>
        {post.data.updatedAt && (
          <span>
            {t.updated}{" "}
            <time datetime={post.data.updatedAt.toISOString()}>
              {dateLabel(post.data.updatedAt, locale)}
            </time>
          </span>
        )}
      </div>
    </header>
    {!translation && (
      <p class="missing-translation" data-pagefind-ignore>
        {t.unavailable}{" "}
        <a href={`/${localeInfo[locale].other}/`}>
          {t.otherArchive} <ArrowRight />
        </a>
      </p>
    )}
    <div class="reading-layout">
      {sections.length > 1 && (
        <details class="toc" open data-pagefind-ignore>
          <summary>{t.contents}</summary>
          <nav aria-label={t.contents}>
            <ol>
              {sections.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )}
      <div class="prose">
        <slot />
      </div>
    </div>
    <License locale={locale} license={post.data.license} />
  </article>
  {related.length > 0 && (
    <section class="related-section">
      <header class="section-heading">
        <h2>{t.related}</h2>
      </header>
      <PostList posts={related} locale={locale} />
    </section>
  )}
</Page>
