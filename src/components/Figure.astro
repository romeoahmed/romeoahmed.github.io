---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
}
const { src, alt } = Astro.props;
---

<figure>
  <Image src={src} alt={alt} />
  {Astro.slots.has("default") && (
    <figcaption>
      <slot />
    </figcaption>
  )}
</figure>
