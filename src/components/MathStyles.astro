---
import stixStyles from "temml/dist/Temml-STIX2.css?raw";

// Use the bundled font while preserving Temml's MathML layout corrections.
const styles = stixStyles.replace(
  /@font-face\s*\{[^}]*\}/,
  `@font-face {
  font-family: STIX2;
  src: url('/fonts/STIXTwoMath.woff2') format('woff2');
  font-display: swap;
}`,
);
---

<style is:inline set:html={`@layer vendor { ${styles} }`}></style>
