---
import stixStyles from "temml/dist/Temml-STIX2.css?raw";
import { Font } from "astro:assets";

// Keep Temml's STIX layout rules; Astro supplies the font face.
const styles = stixStyles.replace(/@font-face\s*\{[^}]*\}/, "");
---

<Font cssVariable="--font-math" />
<style
  is:inline
  set:html={`@layer vendor { ${styles} math { font-family: var(--font-math); } }`}
></style>
