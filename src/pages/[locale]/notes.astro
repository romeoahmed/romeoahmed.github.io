---
import "../../styles/notes.css";
import type { InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import License from "../../components/License.astro";
import Page from "../../layouts/Page.astro";
import {
  localePaths,
  localeInfo,
  locales,
  dateLabel,
} from "../../i18n/locales";
import { messages } from "../../i18n/messages";
import { getNotes } from "../../publication/collections";
import { site } from "../../site";
export const getStaticPaths = localePaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { locale } = Astro.props;
const t = messages[locale];
const notes = await Promise.all(
  (await getNotes(locale)).map(async (note) => {
    const { Content } = await render(note);
    return { note, Content };
  }),
);
---

<Page
  locale={locale}
  title={`${t.notes} — ${site.author}`}
  description={t.notesIntro}
  languageUrl={`/${localeInfo[locale].other}/notes/`}
  alternates={locales.map((locale) => ({ locale, url: `/${locale}/notes/` }))}
>
  <header class="page-heading">
    <p class="eyebrow" data-reveal>
      {t.notes}
    </p>
    <h1 data-reveal>{t.notesTitle}</h1>
    <p class="lead" data-reveal>
      {t.notesIntro}
    </p>
  </header>
  <div class="notes-list">
    {notes.length === 0 && <p>{t.empty}</p>}
    {notes.map(({ note, Content }) => (
      <article class="note" data-reveal data-pagefind-body>
        <div class="note-meta" data-pagefind-ignore>
          <time datetime={note.data.publishedAt.toISOString()}>
            {dateLabel(note.data.publishedAt, locale)}
          </time>
          {note.data.sample && <span>{t.sample}</span>}
        </div>
        <div class="prose">
          <h2 id={note.data.slug}>
            <a href={`#${note.data.slug}`}>{note.data.title}</a>
          </h2>
          <Content />
        </div>
      </article>
    ))}
  </div>
  {notes[0] && <License locale={locale} license={notes[0].note.data.license} />}
</Page>
